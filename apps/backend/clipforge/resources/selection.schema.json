{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectionOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "funny",
                "action",
                "fails",
                "unexpected",
                "game_details"
              ]
            }
          },
          "start_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "end_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clarity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "hook": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "completeness": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "emotion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "novelty": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "relevance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "required": [
              "clarity",
              "hook",
              "completeness",
              "emotion",
              "novelty",
              "relevance"
            ]
          },
          "visual_review_required": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "categories",
          "start_id",
          "end_id",
          "evidence_ids",
          "reason",
          "scores",
          "visual_review_required"
        ]
      }
    }
  },
  "required": [
    "candidates"
  ]
}
