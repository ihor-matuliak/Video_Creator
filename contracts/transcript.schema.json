{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedTranscript",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timing_level": {
      "enum": [
        "word",
        "segment"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "ordinal",
          "start_ms",
          "end_ms",
          "text"
        ]
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "ordinal",
          "start_ms",
          "end_ms",
          "text"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "succeeded",
              "failed",
              "pending",
              "unknown_outcome"
            ]
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "state"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "timing_level",
    "language",
    "duration_ms",
    "words",
    "segments",
    "coverage"
  ]
}
