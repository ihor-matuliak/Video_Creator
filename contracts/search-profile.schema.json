{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "funny",
          "action",
          "fails",
          "unexpected",
          "game_details"
        ]
      }
    },
    "custom_instruction": {
      "type": "string",
      "maxLength": 2000
    },
    "min_duration_ms": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 600000
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 600000
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "allow_partial": {
      "type": "boolean"
    }
  },
  "required": [
    "categories",
    "custom_instruction",
    "min_duration_ms",
    "max_duration_ms",
    "max_candidates",
    "allow_partial"
  ]
}
